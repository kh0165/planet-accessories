# Copy this file to ".env" for local development and fill in the values.
# On Render, set these as Environment Variables in the dashboard instead.

# --- Core Django ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Comma-separated. In production Render's hostname is added automatically.
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated full origins, e.g. https://your-app.onrender.com
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Easiest: a single connection string (Neon gives you this).
# Example: postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Or, for quick local dev with SQLite, set this to True and leave DATABASE_URL blank:
USE_SQLITE=False

# (Alternative to DATABASE_URL: set these individual values instead)
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432
